{
  "version": "research-core-v1-contract",
  "description": "Formal feature contract for the frozen Research Core v1 XGBoost primary risk model.",
  "target": "future_growth_faltering_180d",
  "prediction_horizon_days": 180,
  "required_features": [
    "child_id",
    "visit_date",
    "sex",
    "date_of_birth",
    "birth_weight_kg",
    "birth_length_cm",
    "gestational_age_weeks",
    "birth_order",
    "apgar_score_5min",
    "delivery_type",
    "weight_kg",
    "length_height_cm",
    "breastfeeding_status",
    "breastfeeding_frequency_per_day",
    "formula_feeding",
    "formula_feeds_per_day",
    "complementary_feeding_started",
    "complementary_feeding_start_age_months",
    "meals_per_day",
    "food_groups_consumed",
    "supplement_use",
    "supplement_type",
    "recent_illness",
    "illness_duration_days",
    "diarrhea_recent",
    "fever_recent",
    "respiratory_illness_recent"
  ],
  "derived_temporal_features": [
    "age_days",
    "verified_waz",
    "verified_haz",
    "observation_count",
    "days_since_previous_visit",
    "weight_change_kg",
    "waz_change",
    "weight_velocity_kg_per_day",
    "weight_velocity_kg_per_30d",
    "waz_velocity_per_day",
    "waz_velocity_per_30d",
    "height_measurement_available",
    "last_observed_height_cm",
    "last_observed_haz",
    "days_since_last_height_measurement",
    "height_change_cm",
    "haz_change",
    "height_velocity_cm_per_day",
    "height_velocity_cm_per_30d",
    "haz_velocity_per_day",
    "haz_velocity_per_30d",
    "waz_rolling_mean_3",
    "weight_rolling_mean_3"
  ],
  "outcome_columns_MUST_NOT_USE_AT_INFERENCE": [
    "future_growth_faltering_180d",
    "has_future_faltering_within_180d",
    "has_sufficient_follow_up_180d"
  ],
  "contract_rules": [
    "1. Future fields and outcome variables MUST NEVER become production inference inputs.",
    "2. The 30-day forecast outputs (Stage 13+) MUST NOT automatically be added to the existing 180-day XGBoost model inputs.",
    "3. The frozen risk model must keep this exact feature contract used during its validated training/evaluation.",
    "4. Features must be provided exactly as required by models/metadata/baseline_feature_metadata_v1.json (including types)."
  ]
}
