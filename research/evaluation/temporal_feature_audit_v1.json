            "feature_name": "waz_trajectory_slope_3v",
            "concept": "Multi-Visit Ordinary Least Squares WAZ Slope over the last 3 observed visits",
            "formula": "beta = Sum((age_i - mean_age)*(waz_i - mean_waz)) / Sum((age_i - mean_age)^2) * 30 (for i in [t-2, t-1, t])",
            "defensive_edge_case_handling": {
                "single_visit_check": "If count of valid visits < 2, return 0.0 (or NaN with missing indicator).",
                "duplicate_age_check": "If Var(age) == 0 (e.g. duplicate visit dates/ages), denominator is 0; return 0.0.",
                "missing_waz_check": "Drop NaN pairs pairwise within the 3-visit window before calculating slope."
            },
            "clinical_rationale": "Dampens transient single-visit measurement noise and identifies steady percentile loss."
        },
        {
